<Project Sdk="Microsoft.NET.Sdk">
  <!-- 스파이크. 머지 대상 아님. 솔루션(.sln)에 넣지 않는다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 다른 Core를 쓰려면 -p:CoreProject=<경로>. 기본은 같은 저장소의 Core. -->
    <CoreProject Condition="'$(CoreProject)' == ''">../../src/Scorecard.Core/Scorecard.Core.csproj</CoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProject)" />
  </ItemGroup>
</Project>
