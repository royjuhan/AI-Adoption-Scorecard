<Project Sdk="Microsoft.NET.Sdk">

  <!-- 스파이크 도구. 남긴다(docs/cases-public/README.md 4절 2). 솔루션에 넣지 않는다.
       CoreDir 기본값은 저장소 src/Scorecard.Core. run-gaps.sh는 커밋된 HEAD 사본을 넘긴다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GapRunner</RootNamespace>
    <CoreDir Condition="'$(CoreDir)' == ''">$(MSBuildThisFileDirectory)../../src/Scorecard.Core</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CoreDir)/Scorecard.Core.csproj" />
  </ItemGroup>

</Project>
